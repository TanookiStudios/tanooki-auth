<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Automatic backups: keep access to the folder the user picked across restarts. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Developer ID download only (scripts/release-mac.sh embeds the matching provisioning profile).
	     Kept out of Release.entitlements: without that profile, macOS refuses to open an app that claims iCloud. -->
	<key>com.apple.application-identifier</key>
	<string>NPT8NXJ7C8.com.tanookistudios.auth</string>
	<key>com.apple.developer.team-identifier</key>
	<string>NPT8NXJ7C8</string>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array><string>iCloud.com.tanookistudios.auth</string></array>
	<key>com.apple.developer.icloud-services</key>
	<array><string>CloudDocuments</string></array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array><string>iCloud.com.tanookistudios.auth</string></array>
	<key>com.apple.developer.associated-domains</key>
	<array><string>webcredentials:auth.tanookistudios.com</string></array>
</dict>
</plist>
