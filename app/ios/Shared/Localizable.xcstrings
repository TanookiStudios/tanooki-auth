    },
    "A favorite's code in the Smart Stack. It comes to the top right after you copy that code on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code eines Favoriten im Smart Stack. Er rückt nach oben, sobald du diesen Code auf deinem iPhone kopierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de un favorito en el Smart Stack. Sube arriba justo después de copiar ese código en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d'un favori dans la pile intelligente. Il passe en haut juste après que vous copiez ce code sur votre iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りのコードをスマートスタックに表示します。iPhoneでそのコードをコピーすると、すぐ一番上に表示されます。"
          }
        }
      }
    },
    "Asks first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt zuerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide confirmación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande d’abord"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Codes for the accounts you starred. Turn on Settings > Show codes on widgets and watch in Tanooki Auth.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes der Konten, die du mit einem Stern markiert hast. Schalte in Tanooki Auth Einstellungen > Codes auf Widgets und Uhr anzeigen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Códigos de las cuentas que marcaste con estrella. Activa Ajustes > Mostrar códigos en widgets y reloj en Tanooki Auth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes des comptes que vous avez mis en favoris. Activez Réglages > Afficher les codes sur les widgets et la montre dans Tanooki Auth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星を付けたアカウントのコードです。Tanooki Auth の［設定］>［ウィジェットとウォッチにコードを表示］をオンにしてください。"
          }
        }
      }
    },
    "Expired": {
