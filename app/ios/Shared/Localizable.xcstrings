    "No favorites yet.\n\nOn your iPhone, open Tanooki Auth, star an account, and turn on Settings > Show codes on widgets and watch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Favoriten.\n\nÖffne auf deinem iPhone Tanooki Auth, markiere ein Konto mit dem Stern und schalte Einstellungen > Codes auf Widgets und Uhr anzeigen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay favoritos.\n\nEn tu iPhone, abre Tanooki Auth, marca una cuenta con la estrella y activa Ajustes > Mostrar códigos en widgets y reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de favoris.\n\nSur votre iPhone, ouvrez Tanooki Auth, ajoutez un compte aux favoris avec l'étoile et activez Réglages > Afficher les codes sur les widgets et la montre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはまだありません。\n\niPhone で Tanooki Auth を開き、アカウントに星を付けて、［設定］>［ウィジェットとウォッチにコードを表示］をオンにしてください。"
          }
        }
      }
    },
    "One favorite's code. Pick it on your iPhone in Tanooki Auth: Settings > Watch face favorite.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code eines Favoriten. Wähle ihn auf deinem iPhone in Tanooki Auth: Einstellungen > Favorit fürs Zifferblatt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de un favorito. Elígelo en tu iPhone en Tanooki Auth: Ajustes > Favorito de la esfera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d'un favori. Choisissez-le sur votre iPhone dans Tanooki Auth : Réglages > Favori du cadran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り1件のコードです。iPhone の Tanooki Auth の［設定］>［文字盤のお気に入り］で選んでください。"
          }
        }
      }
    },
    "Opens Tanooki Auth's camera to add an account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Kamera von Tanooki Auth, um ein Konto hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la cámara de Tanooki Auth para añadir una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l'appareil photo de Tanooki Auth pour ajouter un compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth のカメラを開いてアカウントを追加します。"
          }
        }
      }
    },
    "Pick a favorite in Tanooki Auth on your iPhone": {
      "extractionState": "manual",
      "localizations": {
