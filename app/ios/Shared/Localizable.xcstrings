    "A favorite's code in the Smart Stack. It comes to the top right after you copy that code on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code eines Favoriten im Smart Stack. Er rückt nach oben, sobald du diesen Code auf deinem iPhone kopierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de un favorito en el Smart Stack. Sube arriba justo después de copiar ese código en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d'un favori dans la pile intelligente. Il passe en haut juste après que vous copiez ce code sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di un preferito nella Smart Stack. Sale in cima subito dopo che copi quel codice sull'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りのコードをスマートスタックに表示します。iPhoneでそのコードをコピーすると、すぐ一番上に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 스택에 표시되는 즐겨찾기 코드예요. iPhone에서 그 코드를 복사하면 바로 맨 위로 올라와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code van een favoriet in de Slimme stapel. Hij komt bovenaan zodra je die code op je iPhone kopieert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de um favorito na Pilha Inteligente. Ele sobe para o topo logo depois que você copia esse código no iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能叠放中显示一个收藏账号的验证码。你在 iPhone 上复制那个验证码后，它会立刻移到最上面。"
          }
        }
      }
    },
    "Asks first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt zuerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide confirmación"
          }
        },
        "fr": {
