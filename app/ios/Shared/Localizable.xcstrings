    "No accounts to fill yet. In Tanooki Auth, open Settings and turn on Fill codes with AutoFill.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Konten zum Einfügen. Öffne in Tanooki Auth die Einstellungen und schalte „Codes mit automatischem Ausfüllen einfügen“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cuentas para rellenar. En Tanooki Auth, abre Ajustes y activa Rellenar códigos con Autorrelleno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte à remplir pour l’instant. Dans Tanooki Auth, ouvrez Réglages et activez Remplir les codes avec le remplissage automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun account da inserire. In Tanooki Auth, apri Impostazioni e attiva Inserisci i codici con Riempimento automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力できるアカウントがまだありません。Tanooki Auth の設定で「自動入力でコードを入力」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 채울 계정이 없어요. Tanooki Auth에서 설정을 열고 '자동 완성으로 코드 채우기'를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen accounts om in te vullen. Open in Tanooki Auth Instellingen en zet Codes automatisch invullen aan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta para preencher ainda. No Tanooki Auth, abra Ajustes e ative Preencher códigos com o Preenchimento Automático."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可填写的账号。请在 Tanooki Auth 中打开“设置”，开启“用自动填充填写验证码”。"
          }
        }
      }
    },
    "No favorites yet.\n\nOn your iPhone, open Tanooki Auth, star an account, and turn on Settings > Show codes on widgets and watch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Favoriten.\n\nÖffne auf deinem iPhone Tanooki Auth, markiere ein Konto mit dem Stern und schalte Einstellungen > Codes auf Widgets und Uhr anzeigen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay favoritos.\n\nEn tu iPhone, abre Tanooki Auth, marca una cuenta con la estrella y activa Ajustes > Mostrar códigos en widgets y reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de favoris.\n\nSur votre iPhone, ouvrez Tanooki Auth, ajoutez un compte aux favoris avec l'étoile et activez Réglages > Afficher les codes sur les widgets et la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun preferito.\n\nSull'iPhone, apri Tanooki Auth, aggiungi una stella a un account e attiva Impostazioni > Mostra i codici su widget e orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはまだありません。\n\niPhone で Tanooki Auth を開き、アカウントに星を付けて、［設定］>［ウィジェットとウォッチにコードを表示］をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 즐겨찾기가 없어요.\n\niPhone에서 Tanooki Auth를 열고 계정에 별표를 한 다음, 설정 > 위젯과 워치에 코드 표시를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen favorieten.\n\nOpen Tanooki Auth op je iPhone, geef een account een ster en zet Instellingen > Codes tonen op widgets en horloge aan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum favorito ainda.\n\nNo seu iPhone, abra o Tanooki Auth, marque uma conta com estrela e ative Ajustes > Mostrar códigos nos widgets e no relógio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有收藏的账号。\n\n在 iPhone 上打开 Tanooki Auth，给账号加星标，并开启“设置”>“在小组件和手表上显示验证码”。"
          }
        }
      }
    },
    "One favorite's code. Pick it on your iPhone in Tanooki Auth: Settings > Watch face favorite.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code eines Favoriten. Wähle ihn auf deinem iPhone in Tanooki Auth: Einstellungen > Favorit fürs Zifferblatt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de un favorito. Elígelo en tu iPhone en Tanooki Auth: Ajustes > Favorito de la esfera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d'un favori. Choisissez-le sur votre iPhone dans Tanooki Auth : Réglages > Favori du cadran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di un preferito. Sceglilo sull'iPhone in Tanooki Auth: Impostazioni > Preferito sul quadrante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り1件のコードです。iPhone の Tanooki Auth の［設定］>［文字盤のお気に入り］で選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 하나의 코드예요. iPhone의 Tanooki Auth에서 고르세요: 설정 > 워치 페이스 즐겨찾기."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code van één favoriet. Kies hem op je iPhone in Tanooki Auth: Instellingen > Favoriet op wijzerplaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de um favorito. Escolha no iPhone, no Tanooki Auth: Ajustes > Favorito no mostrador do relógio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个收藏账号的验证码。请在 iPhone 上的 Tanooki Auth 中选择：“设置”>“表盘收藏账号”。"
          }
        }
      }
    },
    "Opens Tanooki Auth's camera to add an account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Kamera von Tanooki Auth, um ein Konto hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la cámara de Tanooki Auth para añadir una cuenta."
          }
        },
        "fr": {
