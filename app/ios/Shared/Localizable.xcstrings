    "share.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read that picture. Try a screenshot of the QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esa imagen. Prueba con una captura del código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette image. Essayez une capture d'écran du code QR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild konnte nicht gelesen werden. Versuche ein Bildschirmfoto des QR-Codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その画像を読み取れませんでした。QRコードのスクリーンショットで試してください。"
          }
        }
      }
    },
