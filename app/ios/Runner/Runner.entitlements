<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Phone link approvals (relay/PROTOCOL.md 2.6). Xcode switches it to production for TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The app's own group MUST stay first: it is where new keychain items go by default, so the vault
	     key stays private to the app. The second group holds only the favorites copy for the widgets. -->
	<!-- iCloud sync (lib/core/sync): the Tanooki Auth iCloud Drive container, registered 2026-10-30. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.tanookistudios.auth</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.tanookistudios.auth</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.tanookistudios.auth</string>
		<string>$(AppIdentifierPrefix)com.tanookistudios.auth.shared</string>
	</array>
</dict>
</plist>
