{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth nutzt die Kamera, um QR-Codes zur Einrichtung der Zwei-Faktor-Anmeldung zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth uses the camera to scan two-factor setup QR codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth usa la cámara para escanear los códigos QR de configuración de la verificación en dos pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth utilise l'appareil photo pour scanner les codes QR de configuration de la double authentification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth usa la fotocamera per scansionare i codici QR di configurazione a due fattori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth は2段階認証の設定用 QR コードを読み取るためにカメラを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth는 2단계 인증 설정 QR 코드를 스캔하기 위해 카메라를 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth gebruikt de camera om QR-codes voor tweestapsverificatie te scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tanooki Auth usa a câmera para escanear códigos QR de configuração de dois fatores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth 使用相机扫描两步验证设置二维码。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth nutzt Face ID, damit deine Codes privat bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth uses Face ID to keep your codes private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth usa Face ID para mantener tus códigos en privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth utilise Face ID pour garder vos codes privés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth usa Face ID per tenere privati i tuoi codici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth はコードを他人に見られないよう Face ID を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth는 코드를 안전하게 지키기 위해 Face ID를 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth gebruikt Face ID om je codes privé te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tanooki Auth usa o Face ID para manter seus códigos privados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanooki Auth 使用 Face ID 保护你的验证码不被他人看到。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
